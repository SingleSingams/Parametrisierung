# Anthropic (Pflicht für Extraktion)
ANTHROPIC_API_KEY=

# Modell (Kosten vs. Qualität):
# - Günstig / schnell (Default im Code): claude-haiku-4-5
# - Stärker bei schwierigen VOs:        claude-sonnet-4-6
# Siehe https://docs.anthropic.com/en/docs/about-claude/models — Preise unter „Pricing“.
ANTHROPIC_MODEL=claude-haiku-4-5

# Andere Anbieter (DeepSeek, OpenAI, Gemini, Kimi, …): In diesem Projekt aktuell nicht
# angebunden — die Extraktion nutzt Anthropic Messages + PDF Files-API. Ein Umstieg wäre
# ein eigener Provider-Adapter (andere SDKs, ggf. nur Klartext-Pfad für billige Modelle).

# Postgres (optional, erst wenn Persistenz angebunden wird)
DATABASE_URL=postgresql://user:pass@localhost:5432/bav_poc
